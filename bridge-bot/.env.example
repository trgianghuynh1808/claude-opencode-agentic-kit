# Copy to .env, then: npm run build && node --env-file=.env dist/index.js
# Leave ADMIN_USER_ID and TELEGRAM_CHAT_ID empty to start in discovery mode (the bot replies with your ids).
BOT_TOKEN=123456:ABC...
ADMIN_USER_ID=
TELEGRAM_CHAT_ID=
# Optional: separate bots for the other roles (create them in BotFather, add to the group as members).
# Without them, their messages come from the main bot with a role label.
# BOT_TOKEN_TECHLEAD=
# BOT_TOKEN_DEV=
# ROOMS_FILE=./rooms.json
# POLL_MS=2000
#
BOT_TOKEN_TECHLEAD=
BOT_TOKEN_DEV=
